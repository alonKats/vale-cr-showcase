# The engine reads these from the process environment (no dotenv loader).
# Both are optional.

# Separate SQLite file for a measurement run, so it never queues behind the
# scheduled collector on `engine/data.db`.
CRPC_DB=

# FX source. Defaults to fixtures/fx.json in this snapshot; production points
# it at the central bank's daily rate (https://api.hacienda.go.cr/indicadores/tc/dolar).
VALE_FX_URL=
