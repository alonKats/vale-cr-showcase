# Copy to web/.env.local. Every value is optional; the build runs with none of them.

# Canonical origin. Every canonical, sitemap entry and OG url resolves against
# it. Defaults to http://localhost:3000 outside Vercel/CI (see lib/seo.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics. ABSENT BY DEFAULT: with neither set, no tag is loaded at all.
# Consent Mode defaults to denied before any tag can run (app/layout.tsx).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
